{
  "name": "spadewick-web",
  "version": "2.0.0-web.0",
  "private": true,
  "description": "Spadewick in the browser: projects live in the tab's memory and leave it only as files the user downloads",
  "type": "module",
  "scripts": {
    "dev": "vite -c vite.web.config.mjs",
    "build": "vite build -c vite.web.config.mjs",
    "preview": "vite preview -c vite.web.config.mjs",
    "test": "vitest run --project unit --project web --project desktop-on-web",
    "test:watch": "vitest --project unit --project web --project desktop-on-web",
    "docs": "node scripts/docs.mjs",
    "test:progress": "vitest run --project desktop-progress"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@resvg/resvg-wasm": "^2.6.2",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "bidi-js": "^1.1.0",
    "buffer": "^6.0.3",
    "fflate": "^0.8.2",
    "harfbuzzjs": "^1.6.2",
    "konva": "^9.3.14",
    "lcms-wasm": "^1.0.5",
    "linebreak": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@xmldom/xmldom": "^0.8.15",
    "axe-core": "^4.13.0",
    "playwright-core": "^1.63.0",
    "svelte": "^4.2.18",
    "vite": "^5.2.11",
    "vitest": "^3.2.7"
  }
}
